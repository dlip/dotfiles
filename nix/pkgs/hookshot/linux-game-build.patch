+unsigned next_letter(const char*& s) {
+    unsigned cp = 0;
+    s += std::max(1, ImTextCharFromUtf8(&cp, s, nullptr));
+    return cp;
+}
+struct TextBounds {
+    int left = 0, top = 0, right = 0, bottom = 0;
+};
+TextBounds text_bounds(const char* s, float scale) {
+    const auto& font = text_font();
+    TextBounds bounds;
+    float pen = 0;
+    unsigned previous = 0;
+    while (*s) {
+        const unsigned cp = next_letter(s);
+        pen += stbtt_GetCodepointKernAdvance(&font, previous, cp) * scale;
+        const int x = (int)std::floor(pen);
+        int x0, y0, x1, y1, advance;
+        stbtt_GetCodepointBitmapBoxSubpixel(&font, cp, scale, scale, pen - x, 0, &x0, &y0, &x1, &y1);
+        bounds.left = std::min(bounds.left, x + x0);
+        bounds.top = std::min(bounds.top, y0);
+        bounds.right = std::max(bounds.right, x + x1);
+        bounds.bottom = std::max(bounds.bottom, y1);
+        stbtt_GetCodepointHMetrics(&font, cp, &advance, nullptr);
+        pen += advance * scale;
+        previous = cp;
+    }
+    bounds.right = std::max(bounds.right, (int)std::ceil(pen));
+    return bounds;
+}
+void text_size(const char* s, int px, int* w, int* h) {
+    const TextBounds bounds = text_bounds(s, stbtt_ScaleForPixelHeight(&text_font(), (float)px));
+    *w = bounds.right - bounds.left, *h = bounds.bottom - bounds.top;
+}
+TextMask text_mask(const char* s, int px, int pad) {
+    const auto& font = text_font();
+    const float scale = stbtt_ScaleForPixelHeight(&font, (float)px);
+    const TextBounds bounds = text_bounds(s, scale);
+    TextMask mask;
+    mask.w = bounds.right - bounds.left + 2 * pad + 2;
+    mask.h = bounds.bottom - bounds.top + 2 * pad + 2;
+    mask.cov.resize((size_t)mask.w * mask.h);
+    std::vector<unsigned char> glyph;
+    float pen = 0;
+    unsigned previous = 0;
+    while (*s) {
+        const unsigned cp = next_letter(s);
+        pen += stbtt_GetCodepointKernAdvance(&font, previous, cp) * scale;
+        const int x = (int)std::floor(pen);
+        int x0, y0, x1, y1, advance;
+        stbtt_GetCodepointBitmapBoxSubpixel(&font, cp, scale, scale, pen - x, 0, &x0, &y0, &x1, &y1);
+        const int width = x1 - x0, height = y1 - y0;
+        if (width && height) {
+            glyph.resize((size_t)width * height);
+            stbtt_MakeCodepointBitmapSubpixel(&font, glyph.data(), width, height, width, scale, scale, pen - x, 0, cp);
+            const int left = pad + 1 + x + x0 - bounds.left, top = pad + 1 + y0 - bounds.top;
+            for (int row = 0; row < height; row++)
+                for (int col = 0; col < width; col++) {
+                    auto& coverage = mask.cov[(size_t)(top + row) * mask.w + left + col];
+                    coverage = std::max(coverage, glyph[(size_t)row * width + col]);
+                }
+        }
+        stbtt_GetCodepointHMetrics(&font, cp, &advance, nullptr);
+        pen += advance * scale;
+        previous = cp;
+    }
+    return mask;
+}
