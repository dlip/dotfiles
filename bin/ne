#!/usr/bin/env python3
import argparse
from collections import Counter
import os
from pathlib import Path
import sys


def main():
    parser = argparse.ArgumentParser(
        description="Extract every NUP package into dump folders",
        epilog="DLC indices are assigned from 0 per title; NUP does not retain original folder indices.",
    )
    parser.add_argument("archive", type=Path)
    parser.add_argument("destination", type=Path, nargs="?", help="defaults to the archive path without .nup")
    args = parser.parse_args()

    try:
        from nup.access import extract_tree
        from nup.read import NupReader
    except ModuleNotFoundError:
        if os.environ.get("NE_NUP_ENV"):
            raise
        repo = Path(__file__).resolve().parent.parent
        expression = (
            f'let flake = builtins.getFlake "git+file://{repo}"; '
            'pkgs = import flake.inputs.nixpkgs { system = builtins.currentSystem; '
            'config.allowUnfree = true; }; '
            'in pkgs.python3.withPackages (ps: [ '
            '(ps.toPythonModule flake.packages.${builtins.currentSystem}.nup) ])'
        )
        os.environ["NE_NUP_ENV"] = "1"
        os.execvp("nix", ["nix", "shell", "--impure", "--expr", expression,
                          "--command", "python3", str(Path(__file__).resolve()), *sys.argv[1:]])

    destination = args.destination or args.archive.with_suffix("")
    with NupReader(str(args.archive)) as reader:
        paths = []
        addons = Counter()
        for package in reader.packages:
            if package.kind_name == "base":
                relative = Path("base")
            elif package.kind_name == "update":
                relative = Path("updates") / str(package.version)
            elif package.kind_name == "addon":
                title = f"{package.title_id:016x}"
                relative = Path("dlc") / title / str(addons[title])
                addons[title] += 1
            else:
                parser.error(f"unsupported package kind: {package.kind_name}")
            if relative in paths:
                parser.error(f"multiple packages map to {relative}")
            paths.append(relative)

        destination.mkdir(parents=True, exist_ok=False)
        for package, relative in zip(reader.packages, paths):
            target = destination / relative
            print(f"Extracting package {package.index} -> {target}", flush=True)
            count = extract_tree(reader, str(target), package.root_dir)
            print(f"  {count} files", flush=True)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        sys.exit(f"ne: {error}")
